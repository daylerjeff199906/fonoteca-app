# URL privada del backend. No usar NEXT_PUBLIC_: el navegador no debe recibirla.
BACKEND_API_URL=http://127.0.0.1:3000/api/v1

# Ajusta estas rutas únicamente si tu backend utiliza una convención distinta.
BACKEND_AUTH_LOGIN_PATH=/auth/login
BACKEND_AUTH_ME_PATH=/auth/me
BACKEND_AUTH_LOGOUT_PATH=/auth/logout
BACKEND_AUTH_FORGOT_PASSWORD_PATH=/auth/forgot-password
BACKEND_AUTH_RESET_PASSWORD_PATH=/auth/reset-password

# Servicio de archivos: solo el servidor Next.js conoce este token.
FILE_SERVICE_URL=http://127.0.0.1:8000
FILE_SERVICE_TOKEN=iiap_fs_live_reemplaza_con_un_token_largo
